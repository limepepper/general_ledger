<!-- Bills Card Start -->
<div class="grid-stack-item"
     gs-id="grid-item-bills-card"
     gs-x="{{ layout['grid-item-bills-card']['x']|default('0') }}"
     gs-y="{{ layout['grid-item-bills-card']['y']|default('4') }}"
     gs-h="{{ layout['grid-item-bills-card']['h']|default('2') }}"
     gs-w="{{ layout['grid-item-bills-card']['w']|default('6') }}"
     gs-min-w="6"
     gs-min-h="2">
    <div class="grid-stack-item-content card">
        <div class="card-header">
            <h5 class="card-title">Bills Card</h5>
        </div>
        <div class="card-body">
            <p>This is some text inside Bills Card.</p>

        </div>
    </div>
</div>
<!-- Bills Card End -->